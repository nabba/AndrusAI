<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.andrus.botarmy.gateway-watchdog</string>

  <!-- Continuous daemon polling http://127.0.0.1:8765/health and restarting
       the gateway container when it stays unresponsive past the threshold.
       Lives on the host because it has to recover the gateway when the
       gateway can't recover itself. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>/Users/andrus/BotArmy/crewai-team/scripts/gateway_watchdog.py</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Tiny grace so a watchdog crash loop doesn't burn CPU. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HEALTH_URL</key>
    <string>http://127.0.0.1:8765/health</string>
    <key>POLL_INTERVAL_SECONDS</key>
    <string>20</string>
    <!-- 2026-06-01: 5→15 so a briefly-busy event loop isn't counted as a failed
         probe; the liveness-heartbeat gate below is the real protection. -->
    <key>HEALTH_TIMEOUT_SECONDS</key>
    <string>15</string>
    <key>FAILURE_THRESHOLD</key>
    <string>6</string>
    <key>RESTART_COOLDOWN_SECONDS</key>
    <string>300</string>
    <!-- §81 (2026-05-31): post-restart grace 90→120, plus an initial boot
         grace so a mid-boot gateway isn't killed before uvicorn binds. -->
    <key>RESTART_GRACE_SECONDS</key>
    <string>120</string>
    <key>BOOT_GRACE_SECONDS</key>
    <string>180</string>
    <!-- 2026-06-01 liveness gate: the gateway writes a heartbeat from a daemon
         thread (app/liveness.py) that survives event-loop starvation. A stale
         heartbeat ⇒ process wedged/dead ⇒ restart. A LIVE process with slow
         /health is NOT restarted until /health is down past HEALTH_ESCALATE —
         a real loop wedge, vs a legitimately long heavy idle job. -->
    <key>HEARTBEAT_STALE_SECONDS</key>
    <string>60</string>
    <key>HEALTH_ESCALATE_SECONDS</key>
    <string>900</string>
    <key>COMPOSE_PROJECT_DIR</key>
    <string>/Users/andrus/BotArmy/crewai-team</string>
    <key>GATEWAY_SERVICE</key>
    <string>gateway</string>
    <key>SIGNAL_CLI_HTTP_URL</key>
    <string>http://127.0.0.1:7583</string>
    <key>SIGNAL_OWNER_NUMBER</key>
    <string>+3725100500</string>
    <key>DOCKER_BIN</key>
    <string>/usr/local/bin/docker</string>
    <key>LOG_PATH</key>
    <string>/Users/andrus/BotArmy/crewai-team/workspace/healing/.gateway_watchdog.log</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/andrus/BotArmy/crewai-team</string>

  <key>StandardOutPath</key>
  <string>/Users/andrus/BotArmy/crewai-team/workspace/healing/.gateway_watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/andrus/BotArmy/crewai-team/workspace/healing/.gateway_watchdog.log</string>
</dict>
</plist>
